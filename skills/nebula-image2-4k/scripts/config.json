{
  "version": "2.1",
  "name": "nebula-image2-4k",
  "label": "Nebula Image2 4K",
  "group": "image2-4k",
  "transport": "images",
  "endpoint": "https://img-api.apinebula.ai",
  "model": "gpt-image-2-4k",
  "model_env": "APINEBULA_IMAGE2_4K_MODEL",
  "available_models": ["gpt-image-2-4k", "gpt-image-2.5-flare", "gpt-image-2.5-sunburst"],
  "default_timeout_seconds": 1800,
  "max_references": 8,
  "max_images": 10,
  "generation": {
    "default_size": "3840x2160",
    "sizes": ["3840x2160"],
    "default_quality": "high",
    "qualities": ["auto", "low", "medium", "high"]
  },
  "editing": {
    "default_size": "3840x2160",
    "sizes": ["3840x2160"],
    "default_quality": "high",
    "qualities": ["auto", "low", "medium", "high"]
  }
}
